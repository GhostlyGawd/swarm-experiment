{
  "name": "@ghostlygawd/aether",
  "version": "0.1.0",
  "description": "Project Aether — a unified, agent-native programming fabric and runtime substrate.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GhostlyGawd/swarm-experiment.git"
  },
  "homepage": "https://github.com/GhostlyGawd/swarm-experiment#readme",
  "bugs": {
    "url": "https://github.com/GhostlyGawd/swarm-experiment/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "bin": {
    "aether": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tier1": {
      "types": "./dist/tier1/index.d.ts",
      "import": "./dist/tier1/index.js"
    },
    "./tier2": {
      "types": "./dist/tier2/index.d.ts",
      "import": "./dist/tier2/index.js"
    },
    "./tier3": {
      "types": "./dist/tier3/index.d.ts",
      "import": "./dist/tier3/index.js"
    },
    "./tier4": {
      "types": "./dist/tier4/index.d.ts",
      "import": "./dist/tier4/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js"
    },
    "./projection": {
      "types": "./dist/projection/index.d.ts",
      "import": "./dist/projection/index.js"
    },
    "./fabric": {
      "types": "./dist/fabric/index.d.ts",
      "import": "./dist/fabric/index.js"
    },
    "./proof": {
      "types": "./dist/tier2/portable-proof-checker.d.ts",
      "import": "./dist/tier2/portable-proof-checker.js"
    },
    "./proof/producer": {
      "types": "./dist/tier2/portable-proof-producer.d.ts",
      "import": "./dist/tier2/portable-proof-producer.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\"",
    "bench": "node --experimental-strip-types bench/nfr.bench.ts",
    "bench:record": "node --experimental-strip-types bench/nfr.bench.ts --record-only",
    "bench:v4:measure": "node --experimental-strip-types bench/v4/cli.ts --measure",
    "bench:v4:enforce": "node --experimental-strip-types bench/v4/cli.ts --enforce",
    "bench:v4:verify": "node --experimental-strip-types bench/v4/verify.ts",
    "witness:serve": "node --experimental-strip-types src/fabric/witness-service-cli.ts",
    "demo": "node --experimental-strip-types src/cli.ts demo",
    "roadmap": "node --experimental-strip-types roadmap/render.ts",
    "roadmap:check": "node --experimental-strip-types roadmap/render.ts --check",
    "roadmap:v4": "node --experimental-strip-types roadmap/v4/render.ts",
    "roadmap:v4:check": "node --experimental-strip-types roadmap/v4/render.ts --check"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "acorn": "8.18.0",
    "acorn-walk": "8.3.5",
    "js-tiktoken": "1.0.21"
  }
}
