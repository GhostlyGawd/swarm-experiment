import{readFileSync,writeFileSync,mkdirSync,existsSync}from'node:fs';import{createHash}from'node:crypto';import{join,resolve}from'node:path';import{execFileSync}from'node:child_process';import assert from'node:assert/strict';
import{decodeAgentIrBinary}from'../../../../src/tier1/agent-ir-v2.ts';import{agentIr3Snapshot,encodeAgentIr3,decodeAgentIr3}from'../../../../src/tier1/agent-ir-v3.ts';import{countTokens}from'../../../../src/util/tokens.ts';
const output=resolve(process.argv[2]);if(existsSync(output))throw Error('refusing to overwrite retained research');
const baseline='roadmap/v4/research/projections/results/campaign-11-generics',read=name=>readFileSync(join(baseline,name)),inputs=read('artifacts.json'),reportBytes=read('report.json'),artifacts=JSON.parse(inputs),baselineReport=JSON.parse(reportBytes),sha=x=>createHash('sha256').update(x).digest('hex');
const paths=['src/tier1/agent-ir-v3.ts','src/tier1/agent-ir-v3-bounds.ts','src/tier1/agent-ir.ts','src/tier1/agent-ir-v2.ts','src/tier1/ast.ts','src/tier1/store.ts','src/util/tokens.ts','roadmap/v4/research/agent-ir3/measure.mjs'];
const registration={format:'aether.agent-ir3.campaign/1',started:new Date().toISOString(),baseline,baselineArtifactsSha256:sha(inputs),baselineReportSha256:sha(reportBytes),workloads:artifacts.map(a=>a.id),rootMessages:artifacts.reduce((n,a)=>n+a.files.length,0),tokenizers:['cl100k_base','o200k_base'],selection:'Fixed full V7 campaign, original root plus every original dependency; no regenerated or removed inputs. Full messages measured independently; session pays initial full snapshot and both base-bound edits. Encoder chooses full vs delta by UTF-8 byte length, not measured tokens.',hypothesis:'Shared bundle dictionaries and explicit edit reuse reduce full/session cost; 4x remains required and is evaluated without omitting identities, headers, dependencies, or base/target bindings.',sources:paths.map(path=>({path,sha256:sha(readFileSync(path))}))};
mkdirSync(output,{recursive:true});writeFileSync(join(output,'preregistration.json'),JSON.stringify(registration,null,2)+'\n');writeFileSync(join(output,'baseline-artifacts.json'),inputs);writeFileSync(join(output,'baseline-report.json'),reportBytes);
const rows=[],messages=[];
for(const artifact of artifacts){let base;const versions=[];for(const file of artifact.files){const input=[file,...file.dependencyModules??[]],snapshot=agentIr3Snapshot(input.map(f=>decodeAgentIrBinary(Buffer.from(f.binary,'base64'))));assert.deepEqual(snapshot.rootRefs,input.map(f=>f.root));const full=encodeAgentIr3(snapshot),session=encodeAgentIr3(snapshot,base);assert.equal(decodeAgentIr3(full).digest,snapshot.digest);assert.equal(decodeAgentIr3(session,base).digest,snapshot.digest);versions.push({rootRefs:snapshot.rootRefs,digest:snapshot.digest,full,session});base=snapshot;}
 messages.push({workload:artifact.id,versions});for(const tokenizer of registration.tokenizers){const old=baselineReport.rows.find(r=>r.workload===artifact.id&&r.tokenizer===tokenizer),full=versions.map(v=>countTokens(v.full,tokenizer)),session=versions.map(v=>countTokens(v.session,tokenizer));rows.push({workload:artifact.id,tokenizer,baselineLegacyCold:old.cold.legacyTsReviewTokens,baselineAe2Cold:old.cold.ae2Tokens,baselineLegacySession:old.session.legacyTsReviewTokens,baselineAe2Session:old.session.ae2CompleteMessages,baselineAe1Session:old.session.ae1SharedDictionaryTokens,cold:full[0],fullMessages:full,sessionMessages:session,session:session.reduce((a,b)=>a+b,0)});}}
const aggregate=registration.tokenizers.map(tokenizer=>{const selected=rows.filter(r=>r.tokenizer===tokenizer),sum=key=>selected.reduce((n,r)=>n+r[key],0),cold=sum('cold'),session=sum('session'),legacyCold=sum('baselineLegacyCold'),ae2Cold=sum('baselineAe2Cold'),legacySession=sum('baselineLegacySession'),ae2Session=sum('baselineAe2Session');return{tokenizer,cold,session,legacyCold,ae2Cold,legacySession,ae2Session,legacyToCandidateCold:legacyCold/cold,legacyToCandidateSession:legacySession/session,coldReductionFromAe2:1-cold/ae2Cold,sessionReductionFromAe2:1-session/ae2Session,meetsFourfoldCold:legacyCold/cold>=4,meetsFourfoldSession:legacySession/session>=4};});
for(const source of registration.sources){const content=readFileSync(source.path);assert.equal(sha(content),source.sha256,'source changed during campaign');const file=join(output,'sources',source.path+'.source');mkdirSync(file.slice(0,file.lastIndexOf('/')),{recursive:true});writeFileSync(file,content);}
writeFileSync(join(output,'messages.json'),JSON.stringify(messages,null,2)+'\n');const report={...registration,completed:new Date().toISOString(),codecHeader:messages[0].versions[0].full.split('\n')[0].split(' ').slice(0,2),node:process.version,git:execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim(),tokenizerPackage:JSON.parse(readFileSync('node_modules/js-tiktoken/package.json')).version,rows,aggregate,qualifiedReleaseDensity:false};writeFileSync(join(output,'report.json'),JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify({output,aggregate},null,2));
