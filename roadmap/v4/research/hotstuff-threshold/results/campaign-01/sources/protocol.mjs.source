/** Explicit research proof and epoch envelopes; none is production admission. */
import assert from 'node:assert/strict';
import { createHash,createPublicKey,sign,verify,randomUUID } from 'node:crypto';
import { readFileSync,writeFileSync,renameSync,openSync,fsyncSync,closeSync,mkdirSync,existsSync } from 'node:fs';
import { dirname } from 'node:path';
import { spawn,spawnSync } from 'node:child_process';
import { createInterface } from 'node:readline';
import { encodeCanonical,decodeCanonical,exactObject } from '../../../../src/fabric/encoding.ts';
import { domainDigest } from '../../../../src/fabric/identity.ts';
import { promotionDigest } from '../../../../src/fabric/promotion.ts';
import { quorumRosterDigest,verifyQuorumCertificate,validateQuorumRoster } from '../../../../src/fabric/quorum-crypto.ts';
export const same=(a,b)=>Buffer.from(encodeCanonical(a)).equals(Buffer.from(encodeCanonical(b)));
export const sha=value=>createHash('sha256').update(value).digest('hex');
export const groupDigest=group=>sha(encodeCanonical(group));
export const proofDigest=proof=>domainDigest('aether.research-threshold-proof/1',proof);
export const transitionDigest=descriptor=>domainDigest('aether.research-membership/1',descriptor);
export function persist(path,value){mkdirSync(dirname(path),{recursive:true,mode:0o700});const temp=`${path}.${randomUUID()}`;writeFileSync(temp,encodeCanonical(value),{mode:0o600,flag:'wx'});const fd=openSync(temp,'r');fsyncSync(fd);closeSync(fd);renameSync(temp,path);const dir=openSync(dirname(path),'r');fsyncSync(dir);closeSync(dir);}
export const read=(path,fallback)=>existsSync(path)?decodeCanonical(readFileSync(path)):fallback;
export function helper(binary,mode,value){const result=spawnSync(binary,[mode],{input:JSON.stringify(value),encoding:'utf8',timeout:30000,maxBuffer:4*1024*1024});if(result.status!==0)throw new Error(`research crypto refused ${mode}: ${result.stderr.trim()}`);return JSON.parse(result.stdout);}
export function validateContext(context,roster){validateQuorumRoster(roster);assert.equal(roster.validators.length,4);assert.equal(roster.faultBound,1);assert.equal(context.vote_roster,quorumRosterDigest(roster));assert.equal(context.membership_epoch,roster.membershipEpoch);assert.equal(context.policy_epoch,roster.policyEpoch);assert.equal(context.repository,roster.repositoryId);assert.deepEqual(context.vote_ids,roster.validators.map(member=>member.id));assert.deepEqual(context.vote_public_keys,roster.validators.map(member=>Buffer.from(member.publicKey,'base64').subarray(-32).toString('hex')));}
export function validateProof(proof,roster,qc=proof?.qc){
  encodeCanonical(proof,{maxFrameBytes:128*1024,maxObjects:10000});exactObject(proof,['format','publicPackage','message','package','shares','signature','qc']);assert.equal(proof.format,'aether.hotstuff-ristretto-proof/1');assert.ok(verifyQuorumCertificate(qc,roster));assert.ok(same(qc,proof.qc));assert.equal(proof.shares.length,qc.votes.length);assert.ok(proof.shares.length>=3&&proof.shares.length<=4);
  for(let index=0;index<qc.votes.length;index++){const share=proof.shares[index];exactObject(share,['participant','authorization','share']);assert.equal(share.participant,roster.validators.findIndex(member=>member.id===qc.votes[index].signer)+1);assert.ok(same(share.authorization,qc.votes[index]));}
  const message=decodeCanonical(Buffer.from(proof.message,'hex'));assert.ok(same(message.vote,qc.body));validateContext(message.context,roster);return message;
}
export function verifyDetached(binary,group,roster,proof,qc=proof.qc){const message=validateProof(proof,roster,qc);assert.ok(same(message.context,group.context));assert.equal(proof.publicPackage,group.publicPackage);const result=helper(binary,'verify',{context:group.context,proof});assert.equal(result.verified,true);assert.equal(result.productionAdmission,false);return result;}
export function normalProposal(roster,parent,candidate){return{format:'aether.promotion/1',repositoryId:roster.repositoryId,expectedParent:parent,candidateManifest:candidate,evidenceBundleDigest:domainDigest('aether.evidence-bundle/1',{normalCandidate:candidate}),migrationPlanDigest:domainDigest('aether.migration-plan/1',{from:parent,to:candidate}),effectPlanDigest:domainDigest('aether.effect-plan/1',{effects:[]}),membershipEpoch:roster.membershipEpoch,policyEpoch:roster.policyEpoch,expiresAt:'99999999999999'};}
export function validateTransition(descriptor,oldRoster){exactObject(descriptor,['format','fromRoster','toRoster','previousBlock','genesisManifest']);assert.equal(descriptor.format,'aether.research-membership/1');assert.equal(descriptor.fromRoster,quorumRosterDigest(oldRoster));validateQuorumRoster(descriptor.toRoster);assert.equal(descriptor.toRoster.validators.length,4);assert.equal(descriptor.toRoster.faultBound,1);assert.equal(descriptor.toRoster.repositoryId,oldRoster.repositoryId);assert.equal(BigInt(descriptor.toRoster.membershipEpoch),BigInt(oldRoster.membershipEpoch)+1n);assert.equal(descriptor.toRoster.policyEpoch,oldRoster.policyEpoch);return descriptor;}
export function transitionProposal(descriptor,oldRoster){validateTransition(descriptor,oldRoster);return{...normalProposal(oldRoster,descriptor.genesisManifest,descriptor.genesisManifest),evidenceBundleDigest:domainDigest('aether.evidence-bundle/1',{handoff:descriptor}),migrationPlanDigest:domainDigest('aether.migration-plan/1',{handoff:transitionDigest(descriptor)})};}
export function authenticate(payload,signer,key){return{payload,signer,signature:sign(null,encodeCanonical({payload,signer}),key).toString('base64')};}
export function checkAuthentication(envelope,roster){exactObject(envelope,['payload','signer','signature']);const member=roster.validators.find(member=>member.id===envelope.signer);assert.ok(member);assert.equal(typeof envelope.signature,'string');assert.match(envelope.signature,/^[A-Za-z0-9+/]{86}==$/);const signature=Buffer.from(envelope.signature,'base64');assert.equal(signature.toString('base64'),envelope.signature);const key=createPublicKey({key:Buffer.from(member.publicKey,'base64'),format:'der',type:'spki'});assert.ok(verify(null,encodeCanonical({payload:envelope.payload,signer:envelope.signer}),key,signature));return envelope.payload;}
export function verifyHandoff(binary,bundle,anchors){
  exactObject(bundle,['descriptor','oldRoster','oldGroup','commitProof']);assert.equal(quorumRosterDigest(bundle.oldRoster),anchors.oldRoster);assert.equal(groupDigest(bundle.oldGroup),anchors.oldGroup);const desc=validateTransition(bundle.descriptor,bundle.oldRoster);const proof=bundle.commitProof;verifyDetached(binary,bundle.oldGroup,bundle.oldRoster,proof);assert.equal(proof.qc.body.phase,'commit');assert.equal(proof.qc.body.parentBlock,desc.previousBlock);assert.equal(proof.qc.body.proposal,promotionDigest(transitionProposal(desc,bundle.oldRoster)));assert.equal(proof.qc.body.candidateManifest,desc.genesisManifest);return transitionDigest(desc);
}
export function validateEpochQuorum(envelopes,roster,expectedPayload){assert.ok(Array.isArray(envelopes)&&envelopes.length>=3&&envelopes.length<=4);const ids=new Set(),families=new Set(),roles=new Set();for(const envelope of envelopes){const payload=checkAuthentication(envelope,roster);assert.ok(same(payload,expectedPayload));assert.ok(!ids.has(envelope.signer));ids.add(envelope.signer);const member=roster.validators.find(member=>member.id===envelope.signer);families.add(member.family);roles.add(member.role);}assert.ok(families.size>=2&&roles.size>=2);}
export class Rpc {
  static async start(binary,args,options={}){const rpc=new Rpc(spawn(binary,args,{stdio:['pipe','pipe','pipe'],...options}));rpc.ready=await rpc.next();return rpc;}
  constructor(child){this.child=child;this.buffer=[];this.waiters=[];this.error='';this.closed=false;createInterface({input:child.stdout}).on('line',line=>{let value;try{value=JSON.parse(line);}catch(error){this.fail(error);return;}const waiter=this.waiters.shift();if(waiter)waiter.resolve(value);else this.buffer.push(value);});child.stderr.on('data',data=>{this.error=(this.error+String(data)).slice(-8000);});child.on('exit',(code,signal)=>{this.closed=true;this.fail(new Error(`peer exited ${code}/${signal}: ${this.error}`));});this.serial=Promise.resolve();}
  fail(error){for(const waiter of this.waiters.splice(0))waiter.reject(error);}
  next(){if(this.buffer.length)return Promise.resolve(this.buffer.shift());if(this.closed)return Promise.reject(new Error(this.error||'peer closed'));return new Promise((resolve,reject)=>this.waiters.push({resolve,reject}));}
  request(value){const call=async()=>{if(this.closed)throw new Error('peer closed');this.child.stdin.write(JSON.stringify(value)+'\n');return this.next();};const result=this.serial.then(call);this.serial=result.catch(()=>{});return result;}
  async call(value){const reply=await this.request(value);if(reply.ok!==true)throw new Error(reply.error??'peer refused');return reply.value;}
  async close(){if(this.closed)return;const done=new Promise(resolve=>this.child.once('exit',resolve));this.child.kill('SIGKILL');await done;}
}
