[package]
name = "aether-hotstuff-threshold-research"
version = "0.1.0"
edition = "2021"
publish = false

[dependencies]
base64 = "=0.22.1"
frost-core = "=3.0.0"
frost-ristretto255 = "=3.0.0"
rand_core = { version = "=0.6.4", features = ["getrandom"] }
serde = { version = "=1.0.228", features = ["derive"] }
serde_json = "=1.0.145"
rustls = { version = "=0.23.45", default-features = false, features = ["std", "ring"] }
rcgen = "=0.14.7"
ring = "=0.17.14"
fs2 = "=0.4.3"
libc = "=0.2.189"

[profile.release]
lto = "thin"
codegen-units = 1
