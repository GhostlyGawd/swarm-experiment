const directory=dirname(fileURLToPath(import.meta.url)),root=resolve(directory,'../../../..'),output=resolve(process.argv[2]??join(directory,'results/campaign-01'));
assert.equal(existsSync(output),false,'retain previous campaigns');mkdirSync(output,{recursive:true});const sourceHashes={};
for(const relative of ['Cargo.toml','Cargo.lock','src/lib.rs','src/custody.rs','src/channel.rs','src/main.rs','src/proof.rs','src/setup.rs','protocol.mjs','peer.mjs','run.mjs']){const bytes=readFileSync(join(directory,relative));sourceHashes[`roadmap/v4/research/hotstuff-threshold/${relative}`]=sha(bytes);const target=join(output,'sources',relative+'.source');mkdirSync(dirname(target),{recursive:true});writeFileSync(target,bytes);}
for(const relative of ['src/fabric/quorum-node.ts','src/fabric/quorum-crypto.ts','src/fabric/quorum-votes.ts','src/fabric/journal-lock.ts','src/fabric/encoding.ts','src/fabric/identity.ts','src/fabric/promotion.ts']){const bytes=readFileSync(join(root,relative));sourceHashes[relative]=sha(bytes);const target=join(output,'sources',relative+'.source');mkdirSync(dirname(target),{recursive:true});writeFileSync(target,bytes);}
const build=spawnSync('cargo',['build','--release','--locked','--manifest-path',join(directory,'Cargo.toml')],{encoding:'utf8',timeout:120000});writeFileSync(join(output,'build.log'),(build.stdout??'')+(build.stderr??''));assert.equal(build.status,0,build.stderr);
const binary=join(directory,'target/release/aether-hotstuff-threshold-research'),binarySha256=sha(readFileSync(binary)),temporary=mkdtempSync(join(tmpdir(),'aether-hotstuff-threshold-'));
const failures=[],checks=[],restarts=[],proofs=[],cohorts=[];let run=0;
async function reject(name,operation){let error;try{await operation();}catch(value){error=value;}assert.ok(error,`expected refusal: ${name}`);checks.push({name,rejected:true,error:String(error.message??error).slice(0,600)});}
const manifest=(name)=>domainDigest('aether.execution/1',{research:name});
const makeRoster=(epoch,keys,ids)=>({format:'aether.quorum-roster/1',repositoryId:'integrated-hotstuff-research',membershipEpoch:String(epoch),policyEpoch:'5',faultBound:1,validators:keys.map((key,index)=>enrollValidator(ids[index],index<2?'fixture-family-a':'fixture-family-b',index%2?'proof':'security',key.publicKey))});
class Cohort {
  static async create(label,roster,keys,genesisManifest,options={}){
    const cohort=new Cohort();Object.assign(cohort,{label,roster,keys,genesisManifest,options,peers:[],configs:[],configPaths:[]});cohorts.push(cohort);
    const setupInput=join(temporary,`${label}-setup.json`);persist(setupInput,{repository:roster.repositoryId,membershipEpoch:roster.membershipEpoch,policyEpoch:roster.policyEpoch,voteRoster:quorumRosterDigest(roster),voteIds:roster.validators.map(member=>member.id),votePublicKeys:roster.validators.map(member=>Buffer.from(member.publicKey,'base64').subarray(-32).toString('hex'))});
    cohort.setup=JSON.parse(execFileSync(binary,['setup',setupInput,join(temporary,label)],{encoding:'utf8'}));
    for(let index=0;index<4;index++){const home=dirname(cohort.setup.configs[index]),cfg={index,roster,privateKey:keys[index].privateKey.export({format:'pem',type:'pkcs8'}).toString(),genesisManifest,directory:join(home,'validator'),custodyConfig:cohort.setup.configs[index],binary,binarySha256,bootstrap:options.bootstrap??false,...(options.handoff?{handoff:options.handoff,anchors:options.anchors}:{})};const path=join(home,'peer-config.json');persist(path,cfg);cohort.configs.push(cfg);cohort.configPaths.push(path);cohort.peers.push(await Rpc.start(process.execPath,['--experimental-strip-types',join(directory,'peer.mjs'),path]));}
    return cohort;
  }
  async restart(index,overrides={}){const before=this.peers[index].ready;await this.peers[index].close();Object.assign(this.configs[index],overrides);persist(this.configPaths[index],this.configs[index]);this.peers[index]=await Rpc.start(process.execPath,['--experimental-strip-types',join(directory,'peer.mjs'),this.configPaths[index]]);restarts.push({cohort:this.label,index,before,after:this.peers[index].ready});}
  async dkg(){for(const peer of this.peers)await peer.call({op:'dkg',command:{op:'Start'}});for(const phase of ['r1','agreement'])for(let index=0;index<4;index++){const targets=Object.fromEntries(this.peers.map((peer,i)=>[String(i+1),peer.ready.address]).filter(([id])=>Number(id)!==index+1));await this.peers[index].call({op:'dkg',command:{op:'Send',phase,targets}});}for(const peer of this.peers)await peer.call({op:'dkg',command:{op:'Part2'}});for(let index=0;index<4;index++){const targets=Object.fromEntries(this.peers.map((peer,i)=>[String(i+1),peer.ready.address]).filter(([id])=>Number(id)!==index+1));await this.peers[index].call({op:'dkg',command:{op:'Send',phase:'r2',targets}});}const publicKeys=[];for(const peer of this.peers)publicKeys.push((await peer.call({op:'dkg',command:{op:'Part3'}})).public_package);assert.ok(publicKeys.every(value=>value===publicKeys[0]));this.group={context:this.setup.context,publicPackage:publicKeys[0]};this.publicKey=helper(binary,'public',{publicPackage:publicKeys[0]}).groupPublicKey;return this.group;}
  async prepare(proposal,transition=null){const status=await this.peers[0].call({op:'status'}),leader=this.roster.validators.findIndex(member=>member.id===status.node.leader);const reports=[];for(const peer of this.peers)reports.push(await peer.call({op:'new-view'}));for(const report of reports)await this.peers[leader].call({op:'receive-new-view',...report});const proposed=await this.peers[leader].call({op:'propose',proposal,transition});return{leader,...proposed};}
  async votes(prepared){const votes=[];for(const peer of this.peers)votes.push(await peer.call({op:'prepare',message:prepared.message,proof:prepared.proof,transition:prepared.transition}));return votes;}
  async threshold(votes,label,{withhold=false}={}){
    const selected=votes.slice(0,3),qc=assembleQuorumCertificate(selected[0].body,selected,this.roster),nonce=`${label}-${++run}`,commitments={};let message;
    for(let index=0;index<3;index++){const reserve=await this.peers[index].call({op:'reserve',authorization:selected[index],nonce,groupPublicKey:this.publicKey});message??=reserve.message;assert.equal(reserve.message,message);commitments[String(index+1)]=reserve.commitments;}
    const pkg=helper(binary,'package',{message,commitments}).package,shares=[];
    for(let index=0;index<2;index++){const value=await this.peers[index].call({op:'sign',nonce,package:pkg});shares.push({participant:index+1,authorization:selected[index],share:value.share});}
    const partial={format:'aether.hotstuff-ristretto-proof/1',publicPackage:this.group.publicPackage,message,package:pkg,shares,signature:'',qc};
    if(withhold){const before=await this.peers[2].call({op:'status'});await this.peers[2].close();await reject('two shares cannot replace a threshold quorum',()=>helper(binary,'aggregate',{context:this.group.context,proof:partial}));await this.restart(2);const after=await this.peers[2].call({op:'status'});assert.ok(same(before.node.lockedQC,after.node.lockedQC));assert.ok(after.custody.nonce_states[nonce]&&!after.custody.nonce_states[nonce].burned);checks.push({name:'reserved nonce and HotStuff lock survive real process restart',passed:true});}
    const last=await this.peers[2].call({op:'sign',nonce,package:pkg});shares.push({participant:3,authorization:selected[2],share:last.share});const proof=helper(binary,'aggregate',{context:this.group.context,proof:{...partial,shares}});verifyDetached(binary,this.group,this.roster,proof,qc);proofs.push({cohort:this.label,proof});return{qc,proof,nonce,package:pkg};
  }
  async finish(prepared,votes,{restartLock=false,withhold=false}={}){
    const preparedQC=assembleQuorumCertificate(votes[0].body,votes.slice(0,3),this.roster);await reject('individual-signature QC cannot advance without Ristretto proof',()=>this.peers[prepared.leader].call({op:'phase-message',phase:'precommit',qc:preparedQC}));
    const prep=await this.threshold(votes,'prepare');let phase=await this.peers[prepared.leader].call({op:'phase-message',phase:'precommit',qc:prep.qc,proof:prep.proof});let next=[];for(const peer of this.peers)next.push(await peer.call({op:'phase',message:phase,proof:prep.proof}));
    const precommit=await this.threshold(next,'precommit');phase=await this.peers[prepared.leader].call({op:'phase-message',phase:'commit',qc:precommit.qc,proof:precommit.proof});next=[];for(const peer of this.peers)next.push(await peer.call({op:'phase',message:phase,proof:precommit.proof}));
    if(restartLock){const before=await this.peers[0].call({op:'status'});await this.restart(0);const after=await this.peers[0].call({op:'status'});assert.ok(same(before.node.lockedQC,after.node.lockedQC));assert.ok(same(before.node.votes,after.node.votes));checks.push({name:'durable lock and all phase votes preserve restart',passed:true});}
    const commit=await this.threshold(next,'commit',{withhold});const bad=structuredClone(commit.proof);bad.signature='00'.repeat(64);await reject('invalid group signature cannot authorize decide',()=>this.peers[prepared.leader].call({op:'phase-message',phase:'decide',qc:commit.qc,proof:bad}));
    const decide=await this.peers[prepared.leader].call({op:'phase-message',phase:'decide',qc:commit.qc,proof:commit.proof});const decisions=[];for(const peer of this.peers)decisions.push(await peer.call({op:'phase',message:decide,proof:commit.proof}));return{prep,precommit,commit,decide,decisions};
  }
  async statuses(){const values=[];for(const peer of this.peers)values.push(await peer.call({op:'status'}));return values;}
}
const started=process.hrtime.bigint();let result;
try{
  const keys=Array.from({length:4},()=>generateKeyPairSync('ed25519')),ids=['validator-a','validator-b','validator-c','validator-d'],roster=makeRoster(2,keys,ids),genesis=manifest('genesis');
  const old=await Cohort.create('epoch-2',roster,keys,genesis,{bootstrap:true});await old.dkg();
  const first=await old.prepare(normalProposal(roster,genesis,manifest('withheld-A'))),votesA=[];for(let index=0;index<2;index++)votesA.push(await old.peers[index].call({op:'prepare',message:first.message,proof:null,transition:null}));
  const proposalB=normalProposal(roster,genesis,manifest('equivocated-B')),bodyB={...first.message.body,block:{...first.message.body.block,proposal:proposalB,id:quorumBlockDigest(quorumRosterDigest(roster),first.message.body.block.parent,promotionDigest(proposalB))}};
  const conflicting={body:bodyB,signer:first.message.signer,signature:sign(null,encodeCanonical({domain:'aether.hotstuff-message-signature/1',body:bodyB,signer:first.message.signer}),keys[0].privateKey).toString('base64')};
  await reject('same-view leader equivocation cannot change an honest vote',()=>old.peers[1].call({op:'prepare',message:conflicting,proof:null}));const votesB=[];for(let index=2;index<4;index++)votesB.push(await old.peers[index].call({op:'prepare',message:conflicting,proof:null}));
  for(const votes of [votesA,votesB])await reject('withheld split votes do not form a QC',()=>assembleQuorumCertificate(votes[0].body,votes,roster));
  for(const peer of old.peers){await peer.call({op:'clock',now:'10'});await peer.call({op:'timeout',view:'1'});}
  const current=manifest('after-view-change'),prepared=await old.prepare(normalProposal(roster,genesis,current)),votes=await old.votes(prepared);
  const unvoted=signQuorumVote(quorumVoteBody(roster,normalProposal(roster,genesis,manifest('not-honestly-voted')),'2','prepare',prepared.message.body.block.parent),roster.validators[0].id,keys[0].privateKey,roster);
  await reject('valid signature outside the durable honest outbox cannot reserve a nonce',()=>old.peers[0].call({op:'reserve',authorization:unvoted,nonce:'unvoted',groupPublicKey:old.publicKey}));
  const normal=await old.finish(prepared,votes,{restartLock:true,withhold:true});assert.ok(normal.decisions.every(value=>value.certificate.id===normal.commit.qc.id));
  const nextKeys=[...keys.slice(0,3),generateKeyPairSync('ed25519')],nextRoster=makeRoster(3,nextKeys,['validator-a','validator-b','validator-c','validator-z']);
  const descriptor={format:'aether.research-membership/1',fromRoster:quorumRosterDigest(roster),toRoster:nextRoster,previousBlock:normal.commit.qc.body.block,genesisManifest:current};const transition=await old.prepare(transitionProposal(descriptor,roster),descriptor),transitionVotes=await old.votes(transition),handoff=await old.finish(transition,transitionVotes);
  const bundle={descriptor,oldRoster:roster,oldGroup:old.group,commitProof:handoff.commit.proof},anchors={oldRoster:quorumRosterDigest(roster),oldGroup:groupDigest(old.group)};verifyHandoff(binary,bundle,anchors);
  const tampered=structuredClone(bundle);tampered.descriptor.toRoster.validators[3].id='validator-y';await reject('changed next roster cannot reuse old-epoch authorization',()=>verifyHandoff(binary,tampered,anchors));
  persist(join(temporary,'epoch-journal.json'),{format:'aether.research-active-epoch/1',active:'2',pending:{handoff:transitionDigest(descriptor),phase:'old-committed'}});
  await reject('old epoch stops voting after committing transition',()=>old.peers[0].call({op:'new-view'}));
  const next=await Cohort.create('epoch-3',nextRoster,nextKeys,current,{handoff:bundle,anchors});await next.dkg();await reject('new epoch cannot vote before activation',()=>next.peers[0].call({op:'new-view'}));const readiness=[];for(const peer of next.peers)readiness.push(await peer.call({op:'ready'}));
  assert.ok((await next.statuses()).every(value=>value.active===false));
  const retirements=[];for(let index=0;index<2;index++)retirements.push(await old.peers[index].call({op:'retire',bundle}));
  await reject('two old retirement receipts cannot authorize new epoch',()=>next.peers[0].call({op:'activate',bundle,retirements,readiness:readiness.slice(0,3)}));
  await old.restart(2,{custodyFault:'after-retirement-marker'});await reject('retirement crash has no premature acknowledgment',()=>old.peers[2].call({op:'retire',bundle}));await old.restart(2,{custodyFault:null});assert.ok((await old.peers[2].call({op:'status'})).custody.retired);retirements.push(await old.peers[2].call({op:'retire',bundle}));
  persist(join(temporary,'epoch-journal.json'),{format:'aether.research-active-epoch/1',active:'2',pending:{handoff:transitionDigest(descriptor),phase:'old-quorum-retired',retirements}});
  await reject('duplicate retirement receipt cannot inflate old quorum',()=>next.peers[0].call({op:'activate',bundle,retirements:[retirements[0],retirements[0],retirements[1]],readiness:readiness.slice(0,3)}));
  await reject('duplicate new-epoch readiness cannot inflate activation quorum',()=>next.peers[0].call({op:'activate',bundle,retirements,readiness:[readiness[0],readiness[0],readiness[1]]}));
  const falseReady=structuredClone(readiness.slice(0,3));falseReady[0].payload.group='00'.repeat(32);await reject('changed new-group readiness cannot authorize activation',()=>next.peers[0].call({op:'activate',bundle,retirements,readiness:falseReady}));
  const activationRequest={op:'activate',bundle,retirements,readiness:readiness.slice(0,3)},activations=[];
  await next.restart(0,{peerFault:'after-activation-publish'});await reject('activation crash cannot acknowledge before durable recovery',()=>next.peers[0].call(activationRequest));await next.restart(0,{peerFault:null});assert.equal((await next.peers[0].call({op:'status'})).active,true);checks.push({name:'published epoch activation survives real process death',passed:true});
  for(const peer of next.peers)activations.push(await peer.call(activationRequest));assert.ok(same(await next.peers[0].call(activationRequest),activations[0]));
  persist(join(temporary,'epoch-journal.json'),{format:'aether.research-active-epoch/1',active:'3',roster:quorumRosterDigest(nextRoster),group:groupDigest(next.group),handoff:transitionDigest(descriptor),activations});
  for(let index=0;index<3;index++)await reject('retired custody refuses all old-epoch reservations',()=>old.peers[index].call({op:'reserve',authorization:votes[index],nonce:'after-retirement',groupPublicKey:old.publicKey}));
  assert.ok((await old.statuses()).every(value=>value.active===false));
  await reject('new epoch rejects an old signed leader proposal',()=>next.peers[0].call({op:'prepare',message:first.message,proof:null}));
  await reject('new epoch rejects an old threshold proof',()=>next.peers[0].call({op:'check-proof',proof:normal.commit.proof}));
  const nextPrepared=await next.prepare(normalProposal(nextRoster,current,manifest('new-epoch-root'))),nextVotes=await next.votes(nextPrepared),nextDecision=await next.finish(nextPrepared,nextVotes);
  assert.ok(nextDecision.decisions.every(value=>value.certificate.id===nextDecision.commit.qc.id));
  result={format:'aether.hotstuff-threshold-research/1',oldEpoch:{roster,group:old.group,certificates:old.setup.certificates,initialSplitVotes:{a:votesA,b:votesB},statuses:await old.statuses()},newEpoch:{roster:nextRoster,group:next.group,certificates:next.setup.certificates,statuses:await next.statuses()},handoff:{bundle,retirements,readiness,activations,journal:read(join(temporary,'epoch-journal.json'),null)},proofs,checks,restarts,elapsedNs:String(process.hrtime.bigint()-started),productionAdmission:false};
  writeFileSync(join(output,'result.json'),JSON.stringify(result,null,2));
}catch(error){failures.push({error:String(error.stack??error)});writeFileSync(join(output,'failures.json'),JSON.stringify(failures,null,2));throw error;}
finally{for(const cohort of cohorts)for(const peer of cohort.peers)await peer.close();rmSync(temporary,{recursive:true,force:true});}
const evidence={format:'aether.hotstuff-threshold-campaign/1',createdAt:new Date().toISOString(),sourceHead:execFileSync('git',['rev-parse','HEAD'],{cwd:root,encoding:'utf8'}).trim(),sourceHashes,binarySha256,cargoLockSha256:sha(readFileSync(join(directory,'Cargo.lock'))),toolchain:{rust:execFileSync('rustc',['--version'],{encoding:'utf8'}).trim(),cargo:execFileSync('cargo',['--version'],{encoding:'utf8'}).trim(),node:process.version},host:{platform:platform(),arch:arch(),release:release(),cpu:cpus()[0]?.model},thresholdProofs:proofs.length,checks:checks.length,restarts:restarts.length,elapsedNs:result.elapsedNs,productionAdmission:false,limitations:['Four-validator same-host simulation; local supervisor, filesystem and fixture identity credentials remain trusted.','Existing HotStuff Ed25519 QCs are retained; matching Ristretto sidecar proofs are mandatory in this research harness, not a production QC format.','One bounded membership transition with old commit proof, durable old-quorum retirement and new readiness/activation; no general partition-tolerant production reconfiguration claim.','No whole-store anti-rollback anchor, HSM, independent operator identity or independent security review.','No production coordinator/runtime admission; no WAN, throughput or latency qualification.']};writeFileSync(join(output,'manifest.json'),JSON.stringify(evidence,null,2));console.log(JSON.stringify({output,thresholdProofs:proofs.length,checks:checks.length,restarts:restarts.length,elapsedNs:result.elapsedNs,productionAdmission:false},null,2));
