import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';
import { execFileSync,spawnSync } from 'node:child_process';
import { existsSync,mkdirSync,readFileSync,writeFileSync } from 'node:fs';
import { dirname,join,resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import { cpus,platform,arch,release } from 'node:os';
import { encodeCanonical,decodeCanonical } from '../../../../src/fabric/encoding.ts';
const directory=dirname(fileURLToPath(import.meta.url)),root=resolve(directory,'../../../..'),output=resolve(process.argv[2]??join(directory,'results/campaign-01'));
assert.equal(existsSync(output),false,'retain prior evidence');mkdirSync(output,{recursive:true});
const sha=value=>createHash('sha256').update(value).digest('hex'),sourceHashes={};
for(const relative of ['Cargo.toml','Cargo.lock','src/lib.rs','src/custody.rs','src/channel.rs','src/main.rs','tests/campaign.rs','fixtures/vote.json','run.mjs']){const bytes=readFileSync(join(directory,relative));sourceHashes[relative]=sha(bytes);const target=join(output,'sources',relative+'.source');mkdirSync(dirname(target),{recursive:true});writeFileSync(target,bytes);}
const prepareStart=process.hrtime.bigint(),prepare=spawnSync('cargo',['test','--release','--locked','--manifest-path',join(directory,'Cargo.toml'),'--no-run'],{encoding:'utf8',timeout:120000,maxBuffer:8*1024*1024});writeFileSync(join(output,'build.log'),(prepare.stdout??'')+(prepare.stderr??''));assert.equal(prepare.status,0,prepare.stderr);const buildNs=String(process.hrtime.bigint()-prepareStart);
const started=process.hrtime.bigint(),run=spawnSync('cargo',['test','--release','--locked','--manifest-path',join(directory,'Cargo.toml'),'--','--test-threads=1','--nocapture'],{encoding:'utf8',timeout:120000,maxBuffer:16*1024*1024});const testsNs=String(process.hrtime.bigint()-started);writeFileSync(join(output,'tests.log'),(run.stdout??'')+(run.stderr??''));writeFileSync(join(output,'attempt.json'),JSON.stringify({status:run.status,signal:run.signal,buildNs,testsNs},null,2));assert.equal(run.status,0,run.stderr);
const evidence=run.stdout.split('\n').filter(line=>line.includes('EVIDENCE ')).map(line=>JSON.parse(line.slice(line.indexOf('EVIDENCE ')+9)));assert.equal(evidence.length,9);
const round=evidence.find(item=>item.scenario==='tls-dkg-custody-restart');assert.ok(round);assert.equal(new Set(round.participant_pids).size,4);assert.equal(round.tls,'TLSv1_3');
const message=decodeCanonical(Buffer.from(round.message_hex,'hex')),vote=JSON.parse(readFileSync(join(directory,'fixtures/vote.json'),'utf8'));assert.deepEqual(encodeCanonical(message.vote),encodeCanonical(vote));assert.equal(sha(encodeCanonical(message.vote)),message.context.vote_digest);assert.equal(sha(encodeCanonical(round.tls_members)),message.context.roster);assert.equal(message.context.membership_epoch,vote.membershipEpoch);assert.equal(message.context.policy_epoch,vote.policyEpoch);assert.equal(message.group_public_key,round.group_public_key);
const crash=evidence.filter(item=>item.signal==='SIGKILL');assert.equal(crash.length,4);assert.ok(crash.every(item=>item.nonce_reused===false));
writeFileSync(join(output,'evidence.json'),JSON.stringify(evidence,null,2));const tree=execFileSync('cargo',['tree','--locked','--manifest-path',join(directory,'Cargo.toml')],{encoding:'utf8'});writeFileSync(join(output,'dependency-tree.txt'),tree);
const manifest={format:'aether.frost-custody-research/1',createdAt:new Date().toISOString(),sourceHead:execFileSync('git',['rev-parse','HEAD'],{cwd:root,encoding:'utf8'}).trim(),sourceHashes,cargoLockSha256:sha(readFileSync(join(directory,'Cargo.lock'))),binarySha256:sha(readFileSync(join(directory,'target/release/aether-frost-custody-research'))),toolchain:{rust:execFileSync('rustc',['--version'],{encoding:'utf8'}).trim(),cargo:execFileSync('cargo',['--version'],{encoding:'utf8'}).trim(),node:process.version},host:{platform:platform(),arch:arch(),release:release(),cpu:cpus()[0]?.model},buildNs,testsNs,tests:9,evidence,limitations:['Research only: fixed one-vote subject, n=4,t=3 and same-host processes, not HotStuff/admission integration.','TLS1.3 mTLS pins enrolled certificates; all-to-all authenticated DKG agreement requires all participants and can fail closed on withholding.','Master keys, TLS key provisioning, local supervisor and OS/filesystem are trusted; participants share a host/user, not adversarial fault-isolated custody.','AEAD random 96-bit nonces assume OS randomness. FROST nonce single use additionally depends on durable state and independent burn-marker files.','A stale encrypted-state file cannot revive a burned nonce, but whole-directory/master-key rollback is not prevented by an external monotonic anchor.','SIGKILL tests are not power-loss tests; fsync/rename and OS file-lock semantics are assumed.','Pinned Rustls/ring libraries have published audit history; these releases and this application composition have not undergone an independent audit here.','No production key ceremony, membership handoff, coordinator admission, robust BFT availability or product latency qualification is claimed.']};writeFileSync(join(output,'manifest.json'),JSON.stringify(manifest,null,2));console.log(JSON.stringify({output,tests:9,crashBoundaries:4,tls:'TLSv1_3',dkgWithSetupNs:round.dkg_with_setup_ns,testsNs},null,2));
