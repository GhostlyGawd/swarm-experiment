[package]
name = "aether-frost-prototype"
version = "0.1.0"
edition = "2021"
publish = false

[dependencies]
frost-ed25519 = "=3.0.0"
rand_core = { version = "=0.6.4", features = ["getrandom"] }
serde = { version = "=1.0.228", features = ["derive"] }
serde_json = "=1.0.145"

[profile.release]
lto = "thin"
codegen-units = 1
