/** Reproducible extraction from the pinned TypeScript reference engine. */
import{writeFileSync}from'node:fs';import{createHash}from'node:crypto';
if(process.versions.unicode!=='17.0')throw Error('requires Unicode 17.0 reference engine');
const lower=[],upper=[],cased=[],ignorable=[];const c=/\p{Cased}/u,i=/\p{Case_Ignorable}/u;
for(let cp=0;cp<=0x10ffff;cp++){if(cp>=0xd800&&cp<=0xdfff)continue;const s=String.fromCodePoint(cp),l=s.toLowerCase(),u=s.toUpperCase();if(s!==l)lower.push([cp,l]);if(s!==u)upper.push([cp,u]);if(c.test(s))cased.push(cp);if(i.test(s))ignorable.push(cp);}
const ranges=values=>{const out=[];for(const cp of values){if(out.length&&out.at(-1)[1]+1===cp)out.at(-1)[1]=cp;else out.push([cp,cp]);}return out;};
const data={unicode:'17.0',lower,upper,cased:ranges(cased),ignorable:ranges(ignorable),trim:[[9,13],[32,32],[160,160],[5760,5760],[8192,8202],[8232,8233],[8239,8239],[8287,8287],[12288,12288],[65279,65279]]};
const json=JSON.stringify(data).replace(/\u2028/g,'\\u2028').replace(/\u2029/g,'\\u2029');const source='/** Generated by research/projections/generate-string-data.mjs; Unicode 17.0.\n * ECMAScript default casing, with contextual Final_Sigma applied by the runtime. */\nexport const STRING_UNICODE_DATA = '+JSON.stringify(json)+';\n';
writeFileSync('src/projection/executable-string-data.ts',source);
writeFileSync('roadmap/v4/research/projections/string-data-provenance.json',JSON.stringify({format:'aether.string-data/1',node:process.version,unicode:process.versions.unicode,icu:process.versions.icu,v8:process.versions.v8,sha256:createHash('sha256').update(source).digest('hex'),counts:{lower:lower.length,upper:upper.length,cased:cased.length,ignorable:ignorable.length},references:['https://tc39.es/ecma262/2024/multipage/text-processing.html#sec-string.prototype.tolowercase','https://www.unicode.org/Public/17.0.0/ucd/SpecialCasing.txt']},null,2)+'\n');
