import {encodeAgentIrBinary} from '../tier1/agent-ir-v2.ts';
import {GraphStore} from '../tier1/store.ts';
import {ModuleResolver} from '../tier1/modules.ts';
import type {Term} from '../tier1/ast.ts';
import type {NodeRef,SymbolId} from '../tier1/ids.ts';
export interface ExecutableProjectionOptions {readonly modules?:ReadonlyMap<NodeRef,Term>}
export type NativeModule=Extract<Term,{kind:'Module'}>;
export function nativeModuleName(ref:NodeRef):string{if(!/^ast:b3:[0-9a-f]{64}$/.test(ref))throw new TypeError('invalid module address');return'aether_'+ref.slice(7);}
export function nativeSymbolName(module:NativeModule,symbol:SymbolId):string{const table=module.symbolTable;if(table.kind!=='SymbolTable')throw new TypeError('module symbol table');const name=table.entries.find(([id])=>id===symbol)?.[1]??symbol;return`v_${name.replace(/[^a-zA-Z0-9_]/g,'_').slice(0,40)}_${symbol.slice(4)}`;}
/** Exact content-addressed closure, followed by the existing reference linker. */
export function linkExecutableModule(module:NativeModule,options:ExecutableProjectionOptions={}):{linked:NativeModule;dependencies:NodeRef[];modules:Map<NodeRef,NativeModule>;resolve:(ref:NodeRef)=>NativeModule}{
 const store=new GraphStore(),root=store.intern(module),modules=new Map<NodeRef,NativeModule>(),visiting=new Set<NodeRef>();let totalBytes=0;
 const visit=(node:NativeModule,ref:NodeRef)=>{if(visiting.has(ref))throw new TypeError('module import cycle');if(modules.has(ref))return;if(modules.size>=64)throw new RangeError('native module closure bound');visiting.add(ref);modules.set(ref,node);for(const member of node.members){if(member.kind!=='Import')continue;nativeModuleName(member.module);if(new Set(member.symbols).size!==member.symbols.length)throw new TypeError('duplicate imported symbol request');const dep=options.modules?.get(member.module);if(!dep||dep.kind!=='Module')throw new TypeError('missing native module dependency '+member.module);encodeAgentIrBinary(dep);const actual=store.intern(dep);if(actual!==member.module)throw new TypeError('native dependency content address mismatch');totalBytes+=JSON.stringify(dep,(_k,v)=>typeof v==='bigint'?String(v):v).length;if(totalBytes>16*1024*1024)throw new RangeError('native module closure byte bound');visit(dep,actual);}visiting.delete(ref);};
 visit(module,root);const resolver=new ModuleResolver(store),resolved=resolver.resolve(root);for(const node of modules.values())for(const member of node.members)if(member.kind==='Import'){const dep=resolver.resolve(member.module).module,available=new Set(dep.members.flatMap(n=>'symbol'in n?[n.symbol]:[]));if(member.symbols.some(s=>!available.has(s)))throw new TypeError('missing requested import symbol');}
 modules.delete(root);return{linked:resolved.module,dependencies:[...modules.keys()].sort(),modules,resolve:ref=>resolver.resolve(ref).module};
}
