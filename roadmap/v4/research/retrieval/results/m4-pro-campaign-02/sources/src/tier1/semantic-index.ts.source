  readonly declaredType?: Ty; readonly typeName?: string; readonly typeDependency?: NodeRef;
  readonly capabilitiesAll?: readonly string[]; readonly scopeDigest?: Digest;
  readonly parent?: { readonly node?: NodeRef; readonly kind?: NodeKind; readonly field?: string };
  readonly child?: { readonly node?: NodeRef; readonly kind?: NodeKind; readonly field?: string };
