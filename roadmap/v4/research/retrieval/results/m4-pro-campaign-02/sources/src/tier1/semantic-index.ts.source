export interface CanonicalVector { readonly format: 'aether.float32-vector/1'; readonly dimensions: number; readonly bytes: string }
export interface QueryEmbedding { readonly format: 'aether.query-embedding/1'; readonly modelDigest: Digest; readonly inputDigest: Digest; readonly vector: CanonicalVector }
export interface StructuralFilter {
