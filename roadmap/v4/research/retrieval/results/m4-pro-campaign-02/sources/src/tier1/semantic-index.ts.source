function write(path: string, bytes: Uint8Array): void { atomicWrite(path, Buffer.from(bytes).toString('utf8')); const fd = openSync(dirname(path), 'r'); try { fsyncSync(fd); } finally { closeSync(fd); } }
export function embeddingModelDigest(model: EmbeddingModelProfile): Digest {
