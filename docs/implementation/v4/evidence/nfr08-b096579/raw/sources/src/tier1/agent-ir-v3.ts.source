import{compactIr3,expandIr3}from'./agent-ir-v3-compact.ts';
/** AE3 research candidate: readable AE1 opcode streams, one paid dictionary per
 * bundle, decimal-packed opaque identities, and explicit base-bound tree edits.
 * No executable syntax, strings, identities or dependency roots are omitted. */
import{createHash}from'node:crypto';import{types as nodeTypes}from'node:util';
import{LINK_SCHEMA,children,linkGroups,scalarPayload,type Term}from'./ast.ts';
import{GraphStore}from'./store.ts';import type{NodeRef}from'./ids.ts';
import{encode,decode,IrContext}from'./agent-ir.ts';
import{encodeAgentIrBinary,decodeAgentIrBinary}from'./agent-ir-v2.ts';
import{validString}from'../fabric/encoding.ts';
import{AGENT_IR3_LIMITS,checkIr3Payload,type Ir3ReadBudget}from'./agent-ir-v3-bounds.ts';
export{AGENT_IR3_LIMITS}from'./agent-ir-v3-bounds.ts';
export type AgentIr3Format='AE3'|'AE3C';
export const AGENT_IR3_PROFILE=Object.freeze({format:'aether.agent-ir3/2',header:'AE3C',priorResearchHeader:'AE3',identities:'decimal packed fixed-width opaque identifiers',edits:'base-and-target-digest bound subtree replacements'});
export interface AgentIr3Snapshot {readonly roots:readonly Term[];readonly rootRefs:readonly NodeRef[];readonly digest:string}
const snapshots=new WeakSet<object>();
const digest=(refs:readonly NodeRef[])=>createHash('sha256').update('aether.agent-ir3.snapshot/1\0'+refs.join('\n')).digest('hex');
const decimal=(hex:string)=>BigInt('0x'+hex).toString();
function freeze<T>(value:T,seen=new Set<object>()):T{if(value&&typeof value==='object'&&!seen.has(value)){seen.add(value);Object.values(value).forEach(v=>freeze(v,seen));Object.freeze(value);}return value;}
export function agentIr3Snapshot(roots:readonly Term[]):AgentIr3Snapshot{
 if(!Array.isArray(roots)||nodeTypes.isProxy(roots)||Reflect.ownKeys(roots).length!==roots.length+1)throw new TypeError('AE3 plain dense roots required');if(roots.length<1||roots.length>AGENT_IR3_LIMITS.roots)throw new RangeError('AE3 root count');
 // Array descriptors are checked by the existing snapshot boundary before use.
 const out:Term[]=[];let bytes=0;for(let i=0;i<roots.length;i++){const d=Object.getOwnPropertyDescriptor(roots,String(i));if(!d||!('value'in d))throw new TypeError('AE3 root accessor/hole');const wire=encodeAgentIrBinary(d.value);bytes+=wire.length;if(bytes>AGENT_IR3_LIMITS.bytes)throw new RangeError('AE3 snapshot byte bound');out.push(decodeAgentIrBinary(wire));}
 const store=new GraphStore(),refs=out.map(root=>store.intern(root)),snapshot=freeze({roots:out,rootRefs:refs,digest:digest(refs)});snapshots.add(snapshot);return snapshot;
}
function requireSnapshot(value:AgentIr3Snapshot):AgentIr3Snapshot{if(!value||!snapshots.has(value))throw new TypeError('AE3 requires a validated snapshot');return value;}
const ENUM=new Set(['kind','t','op','variant','rigor','purity','objective','d','overflow']);
const sym=/^sym:([a-z2-7]{22})$/,ast=/^ast:b3:([0-9a-f]{64})$/;
const alphabet='abcdefghijklmnopqrstuvwxyz234567';
function idNumber(value:string):bigint{if(value.startsWith('ast:'))return BigInt('0x'+value.slice(7));let n=0n;for(const c of value.slice(4))n=(n<<5n)|BigInt(alphabet.indexOf(c));return n;}
function pack(ids:string[],bits:number):string{let n=0n;for(const id of ids)n=(n<<BigInt(bits))|idNumber(id);return ids.length?n.toString():'-';}
function unpack(count:number,text:string,bits:number):string[]{if(!count){if(text!=='-')throw new SyntaxError('AE3 empty identity table');return[];}if(!/^(0|[1-9][0-9]*)$/.test(text)||text.length>Math.ceil(count*bits*0.302)+1)throw new SyntaxError('AE3 identity integer');let n=BigInt(text);if(n>>BigInt(count*bits))throw new SyntaxError('AE3 identity overflow');const mask=(1n<<BigInt(bits))-1n,rows:string[]=[];for(let i=0;i<count;i++){let v=n&mask;n>>=BigInt(bits);if(bits===256)rows.unshift('ast:b3:'+v.toString(16).padStart(64,'0'));else{let s='';for(let j=0;j<22;j++){s=alphabet[Number(v&31n)]+s;v>>=5n;}rows.unshift('sym:'+s);}}if(new Set(rows).size!==rows.length||rows.some((r,i)=>i>0&&rows[i-1]>=r))throw new SyntaxError('AE3 identity order/duplicates');return rows;}
interface Tables {symbols:string[];asts:string[]}
function tables(roots:readonly Term[]):Tables{const symbols=new Set<string>(),asts=new Set<string>();const visit=(v:unknown,key=''):void=>{if(typeof v==='string'&&!ENUM.has(key)){if(sym.test(v))symbols.add(v);if(ast.test(v))asts.add(v);}else if(Array.isArray(v))v.forEach(x=>visit(x));else if(v&&typeof v==='object')Object.entries(v).forEach(([k,x])=>visit(x,k));};roots.forEach(r=>visit(r));return{symbols:[...symbols].sort(),asts:[...asts].sort()};}
function atoms<T>(value:T,tables:Tables,restore=false,key=''):T{
 if(typeof value==='string'&&!ENUM.has(key)){
  if(restore){const alias=/^([sa])(0|[1-9][0-9]*)$/.exec(value);if(alias){const row=(alias[1]==='s'?tables.symbols:tables.asts)[Number(alias[2])];if(row===undefined)throw new SyntaxError('AE3 identity index');return row as T;}return value.replace(/%([0-9A-F]{2})/g,(_,h)=>String.fromCharCode(parseInt(h,16))) as T;}
  const list=sym.test(value)?tables.symbols:ast.test(value)?tables.asts:null;if(list)return((list===tables.symbols?'s':'a')+list.indexOf(value)) as T;
  const encoded=value.replace(/[%|,;<>\u0000-\u001f\u007f]/g,c=>'%'+c.charCodeAt(0).toString(16).toUpperCase().padStart(2,'0'));return (/^[sa][0-9]+$/.test(encoded)?'%'+encoded.charCodeAt(0).toString(16).toUpperCase()+encoded.slice(1):encoded) as T;
 }
 if(Array.isArray(value))return value.map(v=>atoms(v,tables,restore)) as T;if(value&&typeof value==='object')return Object.fromEntries(Object.entries(value).map(([k,v])=>[k,atoms(v,tables,restore,k)])) as T;return value;
}
function payloads(roots:readonly Term[],format:AgentIr3Format):string{const table=tables(roots);if(table.symbols.length>AGENT_IR3_LIMITS.identities||table.asts.length>AGENT_IR3_LIMITS.identities)throw new RangeError('AE3 identity bound');const ctx=new IrContext(),budget:Ir3ReadBudget={pools:new Map(),tokens:0,work:0};let out=`${table.symbols.length} ${pack(table.symbols,110)} ${table.asts.length} ${pack(table.asts,256)}\n${roots.length}\n`;for(const root of roots){const raw=encode(atoms(root,table),ctx).text;checkIr3Payload(raw,budget);const text=format==='AE3C'?compactIr3(raw):raw;out+=Buffer.byteLength(text)+':'+text;}return out;}
class Reader {offset=0;bytes:Buffer;constructor(message:string){validString(message);this.bytes=Buffer.from(message);if(this.bytes.length>AGENT_IR3_LIMITS.bytes)throw new RangeError('AE3 message bound');}line():string{const end=this.bytes.indexOf(10,this.offset);if(end<0)throw new SyntaxError('AE3 truncated header');const out=this.bytes.subarray(this.offset,end).toString();this.offset=end+1;return out;}frame():string{const end=this.bytes.indexOf(58,this.offset);if(end<0)throw new SyntaxError('AE3 frame length');const count=number(this.bytes.subarray(this.offset,end).toString(),AGENT_IR3_LIMITS.bytes);this.offset=end+1;if(count>this.bytes.length-this.offset)throw new SyntaxError('AE3 truncated frame');const bytes=this.bytes.subarray(this.offset,this.offset+count);this.offset+=count;const value=bytes.toString('utf8');if(!Buffer.from(value).equals(bytes))throw new SyntaxError('AE3 UTF-8 frame');return value;}}
function number(text:string,max:number):number{if(!/^(0|[1-9][0-9]*)$/.test(text)||text.length>9||Number(text)>max)throw new SyntaxError('AE3 count');return Number(text);}
function readPayloads(reader:Reader,format:AgentIr3Format,max:number=AGENT_IR3_LIMITS.patches):Term[]{const row=reader.line().split(' ');if(row.length!==4)throw new SyntaxError('AE3 identity header');const table={symbols:unpack(number(row[0],AGENT_IR3_LIMITS.identities),row[1],110),asts:unpack(number(row[2],AGENT_IR3_LIMITS.identities),row[3],256)},count=number(reader.line(),max),ctx=new IrContext(),budget:Ir3ReadBudget={pools:new Map(),tokens:0,work:0},roots:Term[]=[];for(let i=0;i<count;i++){const wire=reader.frame(),text=format==='AE3C'?expandIr3(wire):wire;checkIr3Payload(text,budget);roots.push(atoms(decode(text,ctx),table,true));}return roots;}
interface Patch {root:number;path:number[];value:Term}
function differences(before:AgentIr3Snapshot,after:AgentIr3Snapshot):Patch[]|null{const out:Patch[]=[],store=new GraphStore(),refs=new WeakMap<object,NodeRef>(),ref=(t:Term)=>{let r=refs.get(t);if(!r){r=store.intern(t);refs.set(t,r);}return r;},scalar=(t:Term)=>JSON.stringify(scalarPayload(t),(_k,v)=>typeof v==='bigint'?{$bigint:String(v)}:v);const walk=(a:Term,b:Term,root:number,path:number[]):void=>{if(ref(a)===ref(b))return;const left=linkGroups(a),right=linkGroups(b);if(a.kind!==b.kind||scalar(a)!==scalar(b)||left.length!==right.length||left.some((g,i)=>g.field!==right[i].field||g.links.length!==right[i].links.length)){out.push({root,path,value:b});return;}const x=children(a),y=children(b);x.forEach((t,i)=>walk(t,y[i],root,[...path,i]));};before.roots.forEach((root,i)=>walk(root,after.roots[i],i,[]));return out.length>AGENT_IR3_LIMITS.patches?null:out;}
function replace(root:Term,path:readonly number[],value:Term):Term{if(!path.length)return value;let offset=path[0];for(const group of linkGroups(root)){if(offset>=group.links.length){offset-=group.links.length;continue;}const child=replace(group.links[offset],path.slice(1),value),field=LINK_SCHEMA[root.kind].find(f=>f.field===group.field)!,row=root as unknown as Record<string,unknown>;if(field.arity==='one'||field.arity==='opt')return{...root,[group.field]:child} as Term;if(field.arity==='pairs'){const pairs=row[group.field] as [string,Term][];return{...root,[group.field]:pairs.map((pair,i)=>i===offset?[pair[0],child]:pair)} as Term;}return{...root,[group.field]:group.links.map((t,i)=>i===offset?child:t)} as Term;}throw new SyntaxError('AE3 patch path');}
function full(snapshot:AgentIr3Snapshot,format:AgentIr3Format):string{return`${format} F ${decimal(snapshot.digest)}\n`+payloads(snapshot.roots,format);}
function delta(snapshot:AgentIr3Snapshot,base:AgentIr3Snapshot,format:AgentIr3Format):string|null{if(snapshot.roots.length!==base.roots.length)return null;const patches=differences(base,snapshot);if(patches===null)return null;return`${format} D ${decimal(base.digest)} ${decimal(snapshot.digest)}\n${patches.length}\n`+patches.map(p=>p.root+' '+(p.path.length?p.path.join('.'):'-')+'\n').join('')+payloads(patches.map(p=>p.value),format);}
export function encodeAgentIr3(snapshot:AgentIr3Snapshot,base?:AgentIr3Snapshot,format:AgentIr3Format|'auto'='auto'):string{if(format==='auto'){const a=encodeAgentIr3(snapshot,base,'AE3'),b=encodeAgentIr3(snapshot,base,'AE3C');return Buffer.byteLength(b)<Buffer.byteLength(a)?b:a;}if(!['AE3','AE3C'].includes(format))throw new TypeError('AE3 format');requireSnapshot(snapshot);if(base)requireSnapshot(base);const complete=full(snapshot,format),change=base?delta(snapshot,base,format):null,message=change!==null&&Buffer.byteLength(change)<Buffer.byteLength(complete)?change:complete;if(Buffer.byteLength(message)>AGENT_IR3_LIMITS.bytes)throw new RangeError('AE3 message bound');return message;}
export function decodeAgentIr3(message:string,base?:AgentIr3Snapshot):AgentIr3Snapshot{
 const reader=new Reader(message),header=reader.line().split(' ');if(!['AE3','AE3C'].includes(header[0])||!['F','D'].includes(header[1])||header.length!==(header[1]==='F'?3:4))throw new SyntaxError('AE3 version/header');const format=header[0] as AgentIr3Format;const hash=(value:string)=>{if(!/^(0|[1-9][0-9]*)$/.test(value)||value.length>78||BigInt(value)>>256n)throw new SyntaxError('AE3 digest');return BigInt(value).toString(16).padStart(64,'0');};let target:string,roots:Term[];
 if(header[1]==='F'){target=hash(header[2]);roots=readPayloads(reader,format,AGENT_IR3_LIMITS.roots);}else{requireSnapshot(base!);if(hash(header[2])!==base!.digest)throw new SyntaxError('AE3 stale base');target=hash(header[3]);const count=number(reader.line(),AGENT_IR3_LIMITS.patches),patches:{root:number;path:number[]}[]=[];for(let i=0;i<count;i++){const row=reader.line().split(' ');if(row.length!==2)throw new SyntaxError('AE3 patch header');const root=number(row[0],base!.roots.length-1),path=row[1]==='-'?[]:row[1].split('.').map(x=>number(x,200000));if(path.length>AGENT_IR3_LIMITS.depth)throw new RangeError('AE3 path depth');patches.push({root,path});}const values=readPayloads(reader,format);if(values.length!==patches.length)throw new SyntaxError('AE3 patch/value count');roots=[...base!.roots];patches.forEach((p,i)=>{roots[p.root]=replace(roots[p.root],p.path,values[i]);});}
 if(reader.offset!==reader.bytes.length)throw new SyntaxError('AE3 trailing data');const snapshot=agentIr3Snapshot(roots);if(snapshot.digest!==target)throw new SyntaxError('AE3 target mismatch');const canonical=header[1]==='F'?full(snapshot,format):delta(snapshot,base!,format)!;if(canonical!==message)throw new SyntaxError('AE3 noncanonical edit/dictionary');return snapshot;
}
